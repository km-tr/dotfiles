[user]
	name = km-tr
	email = kumagai@bear.tokyo
[core]
	excludesFile = ~/.gitignore_global
	editor = vim
[push]
	default = current
	autosetupremote = true
[rebase]
	autosquash = true
	autostash = true
	updateRefs = true
[color]
  ui = auto
[fetch]
	prune = true
[pull]
	rebase = merges
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
[gpg]
	format = ssh
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[rerere]
	enabled = true
[remote]
	default = origin
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
# 署名鍵と SSH の push はマシンごとに置く (chezmoi 管理外)
[include]
	path = ~/.gitconfig.local
